Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qin", " ", "=", " ", "10"}], ";", " ", 
   RowBox[{"qout", " ", "=", " ", "10"}], ";", " ", 
   RowBox[{"cin", " ", "=", " ", "5"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"qin", " ", "cin"}], " ", "-", " ", 
            RowBox[{"qout", " ", 
             RowBox[{"x", "[", "t", "]"}]}]}], ")"}], "/", "100"}]}], ",", 
        " ", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "20"}]}], "}"}], ",", 
      " ", 
      RowBox[{"x", "[", "t", "]"}], ",", " ", "t"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], " ", "/.", " ", "sol"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "\[Rule]", " ", "\"\<Lake Pollution Model\>\""}]}], 
