  RowBox[{
   RowBox[{"k", " ", "=", " ", "0.5"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"-", "k"}], " ", 
          RowBox[{"c", "[", "t", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"c", "[", "0", "]"}], " ", "==", " ", "10"}]}], "}"}], ",", 
      " ", 
      RowBox[{"c", "[", "t", "]"}], ",", " ", "t"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"c", "[", "t", "]"}], " ", "/.", " ", "sol"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "10"}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotLabel", " ", "\[Rule]", " ", "\"\<Single Cold Pill\>\""}]}], 
