Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"NDSolve", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"-", "0.4"}], " ", 
          RowBox[{"y", "[", "t", "]"}]}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"-", "0.3"}], " ", 
          RowBox[{"x", "[", "t", "]"}]}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "100"}], ",", " ", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], " ", "==", " ", "80"}]}], "\n", "   ", 
       "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
