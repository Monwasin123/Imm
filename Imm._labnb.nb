Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"NDSolve", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"0.1", " ", 
             RowBox[{"y", "[", "t", "]"}]}]}], ")"}]}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "+", " ", 
          RowBox[{"0.05", " ", 
           RowBox[{"x", "[", "t", "]"}], " ", 
           RowBox[{"y", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "40"}], ",", " ", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], " ", "==", " ", "9"}]}], "\n", "   ", 
       "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "50"}], "}"}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
